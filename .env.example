# ============================
# DJANGO / SALEOR SETTINGS
# ============================

SECRET_KEY=dev-secret-key-change-me
DEBUG=true

# Разрешаем всё, чтобы не мешало во время настройки
ALLOWED_HOSTS=*
ALLOWED_CLIENT_HOSTS=*
CORS_ALLOWED_ORIGINS=*
ALLOWED_GRAPHQL_ORIGINS=*

# API теперь доступно по /graphql/
APP_MOUNT_URI=/graphql/

GRAPHQL_PLAYGROUND_ENABLED=True
GRAPHQL_EXTRA_OPTIONS={"includeIntrospection": true}

ENABLE_SSL=True

# ============================
# PUBLIC API URL
# ============================

API_URL=https://vspomni.store/graphql/

# ============================
# DATABASE
# ============================

DB_NAME=saleor
DB_USER=saleor
DB_PASSWORD=saleor
DATABASE_URL=postgres://saleor:saleor@db:5432/saleor

# ============================
# REDIS / CELERY
# ============================

CELERY_BROKER_URL=redis://redis:6379/0
REDIS_URL=redis://redis:6379/1

# ============================
# EMAIL (OTP, reset password, ops alerts)
# ============================
# Dev (docker + mailpit UI http://127.0.0.1:8025):
EMAIL_URL=smtp://mailpit:1025
DEFAULT_FROM_EMAIL=noreply@vspomni.store
FRONTEND_URL=https://vspomni.store
#
# Prod (пример Yandex):
# EMAIL_URL=smtps://login:password@smtp.yandex.ru:465
# DEFAULT_FROM_EMAIL=noreply@vspomni.store
# FRONTEND_URL=https://vspomni.store

# ============================
# DASHBOARD
# ============================

DASHBOARD_URL=http://nginx/dashboard/

MEDIA_URL=https://vspomni.store/media/
STATIC_URL=https://vspomni.store/static/
THUMBNAIL_URL=https://vspomni.store/thumbnail/
PUBLIC_URL=https://vspomni.store
SITE_DOMAIN=vspomni.store
PUBLIC_URL=https://vspomni.store
STOREFRONT_API_URL=https://vspomni.store/graphql/