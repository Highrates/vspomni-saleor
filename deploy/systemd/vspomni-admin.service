[Unit]
Description=Vspomni Next.js Admin
After=network.target vspomni-api.service

[Service]
Type=simple
User=vspomni
Group=vspomni
WorkingDirectory=/opt/vspomni/Admin
EnvironmentFile=-/opt/vspomni/Admin/.env.local
Environment=NODE_ENV=production
Environment=PORT=3020
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/npx next start -H 127.0.0.1 -p 3020
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/vspomni/Admin

[Install]
WantedBy=multi-user.target
