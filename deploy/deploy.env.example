# Скопировать: cp deploy/deploy.env.example deploy/deploy.env
# deploy/deploy.env не коммитить.
#
# Новый VPS Vspomni — НЕ Miraflores, НЕ ~/Saleor-miraflores.

DEPLOY_HOST=root@NEW_VPS_IP
DEPLOY_PATH=/opt/vspomni
DEPLOY_BRANCH=main

# SSH на VPS (отдельный ключ от Mira)
DEPLOY_SSH_KEY=~/.ssh/id_ed25519_vspomni

# Опционально: git remote монорепо (если деплой через git pull на сервере)
# MONO_GIT_REMOTE=git@github.com:ORG/Vspomni.git
